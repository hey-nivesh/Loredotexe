# ==============================================================================
# Loredotexe - Environment Configuration Template (.env.example)
# ==============================================================================
# Instructions: Copy this file to .env and fill in the required values.
# NEVER commit the actual .env file or real secrets to version control.
# ==============================================================================

# --- Core Application & State Settings (Phase 1) ---
APP_NAME=loredotexe
APP_ENV=development
PORT=3000
HOST=127.0.0.1
PROJECT_DATA_DIR=./data
SQLITE_DATABASE_PATH=./data/loredotexe.sqlite
LOG_LEVEL=info

# --- Orchestration & n8n Bridge ---
N8N_BASE_URL=http://localhost:5678
# N8N_API_KEY=optional_placeholder_if_needed_in_future_phases

# --- n8n Orchestration Settings ---
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
# Secret encryption key for local n8n credential store (generate random string)
N8N_ENCRYPTION_KEY=4hrb8ygrry8ryr8gr6gr7yr87348r7rry4rgrg3r9gr9g2y2e23eh23grtte72ge8g28yg8gr8g3fg3fg8

# --- Free/Local LLM Endpoints & Free-tier API Placeholders ---
# Local LLM service (e.g., Ollama / LM Studio if installed locally)
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3.2:3b

# Free Tier Cloud LLM API Keys (Optional / Phase-deferred)
# GEMINI_API_KEY=your_gemini_api_key_here
# GROQ_API_KEY=your_groq_api_key_here

# --- Voice / TTS Synthesis Settings (Free / Local) ---
# Options: edge-tts (local/free), piper (local)
TTS_ENGINE=edge-tts
TTS_VOICE=en-US-ChristopherNeural

# --- Storage & Google Drive Integration Placeholders (Phase-deferred) ---
GOOGLE_CLIENT_ID=your_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_oauth_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5678/rest/oauth2-credential/callback
GOOGLE_DRIVE_FOLDER_ID=your_target_folder_id_here

# --- YouTube Publishing Placeholders (Phase-deferred) ---
YOUTUBE_CHANNEL_ID=your_youtube_channel_id_here
YOUTUBE_API_KEY=your_youtube_api_key_placeholder

# --- Media Generation Engine (Phase 5) ---
MEDIA_GENERATION_ENABLED=false
MEDIA_GENERATION_MODE=mock

MEDIA_ALLOW_MODEL_DOWNLOAD=false

VIDEO_MODEL_PROVIDER=auto
VIDEO_MODEL_VARIANT=auto
VIDEO_MODEL_PATH=

VIDEO_DEFAULT_WIDTH=832
VIDEO_DEFAULT_HEIGHT=480
VIDEO_DEFAULT_FPS=16
VIDEO_DEFAULT_DURATION_SECONDS=5

VIDEO_MAX_CONCURRENT_JOBS=1

MEDIA_MIN_FREE_DISK_GB=20
MEDIA_MAX_RETRIES=2
MEDIA_MIN_FREE_DISK_GB=5.0
MEDIA_JOB_TIMEOUT_MS=180000
MEDIA_VALIDATION_ENABLED=true
MEDIA_DURATION_TOLERANCE_SECONDS=0.75

# --- Voice, Subtitles & Final Video Assembly (Phase 6) ---
ASSEMBLY_MODE=mock
TTS_PROVIDER=mock
TTS_DEFAULT_VOICE=en_US_male_narrator
TTS_SAMPLE_RATE=24000
TTS_CACHE_ENABLED=true

MUSIC_ENABLED=true
MUSIC_DIR=./data/media/audio/music
MUSIC_VOLUME=0.15

SFX_ENABLED=true
SFX_DIR=./data/media/audio/sfx
SFX_VOLUME=0.20

SUBTITLES_ENABLED=true
SUBTITLE_FONT=Inter
SUBTITLE_FONT_SIZE=28
SUBTITLE_MARGIN_V=35

RENDER_PROFILE=MEDIUM
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
ENCODER_THREADS=4
MAX_ALLOWED_DURATION_OVERFLOW_SECONDS=2.0